# Local defaults used by the API and worker. Override for non-local environments.
DATABASE_URL=postgresql://stacklens:stacklens@127.0.0.1:55432/stacklens

# Optional hosted PostgreSQL settings; retain local pool defaults when unset.
# STACKLENS_DATABASE_POOL_MAX=3
# STACKLENS_DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----... (actual multiline PEM)
# Remove ssl/sslmode/sslrootcert URL parameters when using the explicit CA.

STACKLENS_API_HOST=127.0.0.1
STACKLENS_API_PORT=3000
STACKLENS_WORKER_CONCURRENCY=2
STACKLENS_RETENTION_HOURS=24

# Optional: authenticate public GitHub REST reads for a higher API rate limit.
# Keep this secret local; do not commit a real token.
# STACKLENS_GITHUB_TOKEN=

# Leave unset for the default Vite /v1 proxy to the local API.
# VITE_STACKLENS_API_BASE_URL=

# FR-100 stays disabled when these are unset. Follow docs/implementation/github-connections.md.
# API only; PUBLIC_ORIGIN is the browser origin. CALLBACK_URL is the separately reviewed HTTPS relay.
# STACKLENS_DATABASE_MODE=worker-managed
# STACKLENS_PUBLIC_ORIGIN=http://localhost:5173
# STACKLENS_GITHUB_CLIENT_ID=
# STACKLENS_GITHUB_CALLBACK_URL=https://REVIEWED_RELAY_ORIGIN/v1/auth/github/callback
# STACKLENS_GITHUB_CLIENT_SECRET=
# STACKLENS_GITHUB_INSTALLATION_URL=https://github.com/apps/YOUR-APP/installations/new
# API and Worker only: independent 32-byte hex encryption key, stored in private configuration.
# STACKLENS_GITHUB_SESSION_KEY=
# Auth-enabled API must use the restricted login, separately from the schema-owning Worker.
