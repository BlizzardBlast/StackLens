{
  "name": "stacklens",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm build && pnpm ui:info && pnpm typecheck && pnpm test && pnpm lint && pnpm format:check",
    "format": "oxfmt .",
    "format:check": "oxfmt . && git diff -- packages/rules-javascript/src/dependency-overlap.ts packages/rules-javascript/src/framework-tool-detection.ts packages/rules-javascript/src/index.ts packages/rules-javascript/src/project-configuration.ts packages/rules-javascript/test/project-detection-analyzer-integration.test.ts packages/rules-javascript/test/project-detection-rules.test.ts && exit 1",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "ui:add": "pnpm --filter @stacklens/ui exec shadcn add",
    "ui:info": "pnpm --filter @stacklens/ui exec shadcn info --json"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.4.2"
}
