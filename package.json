{
  "name": "stacklens",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm build && pnpm runtime:smoke && pnpm ui:info && pnpm typecheck && pnpm test && pnpm test:browser && pnpm lint && pnpm format:check",
    "dev": "pnpm dev:prepare && pnpm -r --parallel --stream --filter @stacklens/api --filter @stacklens/worker --filter @stacklens/web run dev",
    "dev:infra": "docker compose up -d postgres",
    "dev:infra:down": "docker compose down",
    "dev:infra:logs": "docker compose logs -f postgres",
    "dev:prepare": "turbo run build --filter=\"@stacklens/api^...\" --filter=\"@stacklens/worker^...\" --filter=\"@stacklens/web^...\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "runtime:smoke": "node ./scripts/runtime-smoke.mjs",
    "test": "pnpm test:deployment && turbo run test",
    "test:browser": "playwright test",
    "test:deployment": "node --test scripts/vercel-config.test.mjs",
    "typecheck": "turbo run typecheck && pnpm typecheck:browser",
    "typecheck:browser": "tsc --project tests/browser/tsconfig.json --noEmit",
    "ui:add": "pnpm --filter @stacklens/ui exec shadcn add",
    "ui:info": "pnpm --filter @stacklens/ui exec shadcn info --json"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@shadcn/lint": "0.2.0",
    "@types/node": "24.13.6",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.4.2"
}
