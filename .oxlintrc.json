{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "plugins": ["eslint", "import", "jsx-a11y", "react", "typescript", "unicorn", "vitest"],
  "settings": {
    "react": {
      "version": "19.3.0"
    }
  },
  "rules": {
    "eslint/eqeqeq": "error",
    "eslint/no-console": "warn",
    "import/no-cycle": "error",
    "react/jsx-no-useless-fragment": "warn",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "design/prototype/**"]
}
