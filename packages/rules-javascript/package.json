{
  "name": "@stacklens/rules-javascript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dependency-inventory": {
      "types": "./dist/dependency-inventory.d.ts",
      "default": "./dist/dependency-inventory.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./analysis-metadata": {
      "types": "./dist/analysis-metadata.d.ts",
      "default": "./dist/analysis-metadata.js"
    },
    "./known-vulnerability": {
      "types": "./dist/known-vulnerability.d.ts",
      "default": "./dist/known-vulnerability.js"
    },
    "./npm-registry-health": {
      "types": "./dist/npm-registry-health.d.ts",
      "default": "./dist/npm-registry-health.js"
    },
    "./outdated-dependency": {
      "types": "./dist/outdated-dependency.d.ts",
      "default": "./dist/outdated-dependency.js"
    },
    "./deprecated-dependency": {
      "types": "./dist/deprecated-dependency.d.ts",
      "default": "./dist/deprecated-dependency.js"
    },
    "./dependency-overlap": {
      "types": "./dist/dependency-overlap.d.ts",
      "default": "./dist/dependency-overlap.js"
    },
    "./framework-tool-detection": {
      "types": "./dist/framework-tool-detection.d.ts",
      "default": "./dist/framework-tool-detection.js"
    },
    "./project-configuration": {
      "types": "./dist/project-configuration.d.ts",
      "default": "./dist/project-configuration.js"
    },
    "./project-snapshot": {
      "types": "./dist/project-snapshot.d.ts",
      "default": "./dist/project-snapshot.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@stacklens/analyzer-core": "workspace:*",
    "@stacklens/contracts": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
