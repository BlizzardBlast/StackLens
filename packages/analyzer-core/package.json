{
  "name": "@stacklens/analyzer-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./analyzer": {
      "types": "./dist/analyzer.d.ts",
      "default": "./dist/analyzer.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "default": "./dist/pipeline.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./scoring": {
      "types": "./dist/scoring.d.ts",
      "default": "./dist/scoring.js"
    },
    "./priority": {
      "types": "./dist/priority.d.ts",
      "default": "./dist/priority.js"
    },
    "./rule-definition": {
      "types": "./dist/rule-definition.d.ts",
      "default": "./dist/rule-definition.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stacklens/contracts": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
