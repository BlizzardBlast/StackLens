  "findingFixes": [
    {
      "priority": "P2",
      "finding": "The callback rejected standard GitHub authorization-error responses containing error_uri before pending-state cleanup and error redirection.",
      "resolution": "Accept optional error_uri strings bounded to 2000 characters and ignore their contents. Retain strict unknown-field rejection, fixed redirects and generic validation errors; publish the same bound and 400 response in OpenAPI.",
      "verification": [
        "Three full callback error envelopes cover access denial, suspended application and callback mismatch with absolute, relative and untrusted error URIs.",
        "Accepted errors clear only pending OAuth state, set no-referrer/no-store headers and return to the fixed error notice without fetching/displaying the URI or storing credentials.",
        "Oversized metadata and unknown fields are rejected before provider I/O.",
        "OpenAPI reflects the bounded optional query field and stable validation response."
      ]
    }
  ],
