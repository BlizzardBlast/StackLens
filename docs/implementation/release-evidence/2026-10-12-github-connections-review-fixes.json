  "findingFixes": [
    {
      "priority": "P1",
      "finding": "Ownership activation checked only policy count and migration retained drift.",
      "resolution": "Validate each owned policy predicate, command, role and permissiveness; atomically reconcile the five owned definitions and reject unexpected policies.",
      "verification": [
        "Real restricted-login PostgreSQL rejects six changed/missing policy cases and repair restores owner-only access.",
        "Unexpected permissive operator policy is rejected without deleting it."
      ]
    },
    {
      "priority": "P2",
      "finding": "Worker name-string discrimination missed actual GitHub configuration failures.",
      "resolution": "Use typed errors through the actual adapter-to-Worker boundary; terminal reconnect for ended/revoked access and sanitized retries for temporary credential lookup failures.",
      "verification": [
        "Actual GitHub 401, 403, 404 and local ended-connection paths produce terminal reconnect without public fallback or report.",
        "Temporary lookup failure uses existing repository_unavailable contract and retry behavior."
      ]
    },
    {
      "priority": "P2",
      "finding": "A pending session response could restore connected UI after sign-out.",
      "resolution": "Cancel pending session queries before clearing private analysis caches and setting signed-out state.",
      "verification": [
        "A started deferred GET is aborted on successful sign-out; its late resolution cannot restore controls or cached private analysis."
      ]
    },
    {
      "priority": "P2",
      "finding": "Credential lookup ignored request timeout and job cancellation.",
      "resolution": "Pass combined AbortSignal into token retrieval and race the request deadline; bound PostgreSQL checkout/I/O and server statements, releasing only the borrowed client; validate expiry after lookup.",
      "verification": [
        "Stalled supplier times out safely with zero GitHub requests.",
        "Worker cancellation aborts lookup; a late token never reaches transport.",
        "Real blocked PostgreSQL query and saturated-pool cases release owned clients and preserve healthy pooled reuse.",
        "Default token expiry clock is read after lookup."
      ]
    },
    {
      "priority": "P2",
      "finding": "Fastify unmatched-route messages exposed URLs outside the request serializer.",
      "resolution": "Register a generic not-found handler and retain fixed validation/server failure responses.",
      "verification": [
        "Real native Pino capture from current TypeScript source contains none of the synthetic callback-code, private-path, cookie or error-detail markers for 404, 400 and 500 requests."
      ]
    }
  ],
