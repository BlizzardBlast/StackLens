  "findingFixes": [
    {
      "priority": "P1",
      "finding": "Connected activation accepted destructive table privileges that bypass RLS.",
      "resolution": "Verify required table privileges and reject extra table/column write, TRUNCATE, TRIGGER, REFERENCES and PostgreSQL 18 MAINTAIN grants across all four tables, including effective PUBLIC grants.",
      "verification": [
        "42 additional owned PostgreSQL cases cover 24 unsafe table grants, nine unsafe column grants, a destructive PUBLIC grant and eight missing required privileges.",
        "Independent restricted-login probe rejects unsafe activation and preserves private ownership; approved grants still activate."
      ]
    },
    {
      "priority": "P2",
      "finding": "Credential creation, deletion and expiry cleanup could block requests and Worker shutdown indefinitely.",
      "resolution": "Share the read path's eight-second total checkout/I/O deadline, transaction-local server timeout and borrowed-client cancellation across all four store operations. Propagate Worker shutdown cancellation into expiry cleanup while retaining analysis ownership drain.",
      "verification": [
        "13 additional real PostgreSQL cases extend lock and checkout deadline/cancellation coverage to every store operation.",
        "Two Worker retention cases cover active purge cancellation and failure retry.",
        "Independent real-lock probe times out blocked writes without committing and completes Worker stop before unlocking; healthy clients retain ordinary timeout settings."
      ]
    }
  ],
