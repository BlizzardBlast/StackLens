  "findingFixes": [
    {
      "priority": "P1",
      "finding": "A schema-writing API login could create a row-type function overload that ran with Worker privileges.",
      "resolution": "Reject effective CREATE on the database or every permanent schema, database/schema ownership even with CREATE revoked, and credential-table ownership. Qualify whole-row, identity and timeout catalog calls in persistence/recovery readers.",
      "verification": [
        "Fresh owned PostgreSQL database accepts approved API grants and rejects ten unsafe grant/ownership cases, including PUBLIC grants and off-search-path schemas.",
        "An actual restricted API creates a hostile exact-type JSON overload; normal Worker reads keep both owner markers intact and anonymous API reads remain denied."
      ]
    },
    {
      "priority": "P2",
      "finding": "An expired cached session was rendered as connected on remount before asynchronous cleanup.",
      "resolution": "Apply session expiry synchronously to every returned cached session and refreshed session; retain timer-driven cancellation and cache removal.",
      "verification": [
        "Real React remount after unobserved expiry hides connected controls on its first render with the refresh stalled.",
        "Private analysis remount does not render its retained session-partitioned cache; expiry cleanup removes the private entry while anonymous loading may continue."
      ]
    }
  ],
