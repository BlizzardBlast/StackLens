# Copy to deploy/.env on the intended host. Never commit real values.
STACKLENS_IMAGE_TAG=
STACKLENS_API_DOMAIN=
STACKLENS_POSTGRES_PASSWORD=
# URI-encode the password. The service hostname is postgres, database/user are stacklens.
STACKLENS_DATABASE_URL=
STACKLENS_RETENTION_HOURS=24
STACKLENS_WORKER_CONCURRENCY=2
# Optional read-only public GitHub provider token; Worker only.
STACKLENS_GITHUB_TOKEN=
